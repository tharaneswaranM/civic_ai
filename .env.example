# ============================================================
# Civic AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ----------------------------------------------------------
# Django Core
# ----------------------------------------------------------
SECRET_KEY=your-very-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------
DATABASE_URL=postgres://civicai_user:password@localhost:5432/civicai_db
DB_NAME=civicai_db
DB_USER=civicai_user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# ----------------------------------------------------------
# Redis (Celery + Caching)
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Local development defaults to LocMemCache. For production/multiple workers,
# set USE_REDIS=True and configure REDIS_URL to a shared Redis cache.
USE_REDIS=False

# ----------------------------------------------------------
# OTP Configuration
# Dev: mock | Production: msg91 | twilio | fast2sms
# ----------------------------------------------------------
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# MSG91 (if OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CIVICAI
MSG91_TEMPLATE_ID=

# Twilio (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Fast2SMS (if OTP_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# ----------------------------------------------------------
# AI / Google Generative AI
# ----------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_AI_MODEL=gemini-1.5-flash
AI_PROVIDER=google

# ----------------------------------------------------------
# Email (for future notifications)
# ----------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@civicai.in

# ----------------------------------------------------------
# Storage
# ----------------------------------------------------------
MEDIA_ROOT=media/
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# ----------------------------------------------------------
# Security (production)
# ----------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
